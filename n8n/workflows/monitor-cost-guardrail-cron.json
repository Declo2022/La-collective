{
  "name": "monitor-cost-guardrail-cron",
  "meta": {
    "description": "Workflow #10 — Garde-fou coût. Toutes les heures : lit fn_cost_status(plafond) et alerte Telegram si l'usage IA du jour atteint 80% (warn) ou 100% (halt) du plafond de tokens."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "id": "trigger-hourly",
      "name": "Toutes les heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from fn_cost_status($1::bigint);",
        "options": {
          "queryReplacement": "={{ $env.OPENAI_DAILY_TOKEN_CAP || 500000 }}"
        }
      },
      "id": "cost-status",
      "name": "Statut coût du jour",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 0],
      "credentials": {
        "postgres": { "id": "SUPABASE_PG", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ]
        }
      },
      "id": "if-not-ok",
      "name": "Dépassement ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_APPROVALS_CHAT_ID }}",
        "text": "=🚨 Coût IA — statut *{{ $json.status }}* ({{ $json.pct }}% du plafond)\\nTokens: {{ $json.tokens }} / {{ $json.token_cap }}  ·  ~{{ $json.usd }} $\\nLes tâches non critiques peuvent être suspendues.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "alert-telegram",
      "name": "Alerte Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, -80],
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_BOT", "name": "Telegram Bot" }
      }
    }
  ],
  "connections": {
    "Toutes les heures": { "main": [[{ "node": "Statut coût du jour", "type": "main", "index": 0 }]] },
    "Statut coût du jour": { "main": [[{ "node": "Dépassement ?", "type": "main", "index": 0 }]] },
    "Dépassement ?": { "main": [[{ "node": "Alerte Telegram", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": [{ "name": "monitor" }, { "name": "mvp" }, { "name": "wf-10" }]
}
