{
  "name": "monitor-anomalies-cron",
  "meta": {
    "description": "Workflow #3 — Détection d'anomalies. Chaque jour : fn_detect_anomalies (100% SQL, aucun LLM) repère ruptures, prix nuls, remboursements, commandes inhabituelles, produits sans vente. Alerte Telegram si anomalies. Lecture seule, aucune écriture Shopify, coût API ~0."
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "cron",
      "name": "Chaque jour 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_detect_anomalies(30, 500) as res;",
        "options": {}
      },
      "id": "detect",
      "name": "Détecter (SQL, sans LLM)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "SUPABASE_PG",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.res.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "id": "if-any",
      "name": "Anomalies ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json.res;\nconst items = res.items || [];\nconst label = { unusual_order: 'Commande inhabituelle', refund: 'Remboursement', zero_price: 'Prix nul', stockout: 'Rupture de stock', no_sales: 'Produit sans vente' };\nconst lines = items.map(i => `• ${label[i.type] || i.type} — ${JSON.stringify(i)}`).join('\\n');\nreturn [{ json: { text: `⚠️ ${items.length} anomalie(s) détectée(s) :\\n${lines}` } }];"
      },
      "id": "format",
      "name": "Formater le message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -80
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_APPROVALS_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "id": "telegram",
      "name": "Alerte Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        -80
      ],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_BOT",
          "name": "Telegram Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Chaque jour 08:00": {
      "main": [
        [
          {
            "node": "Détecter (SQL, sans LLM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Détecter (SQL, sans LLM)": {
      "main": [
        [
          {
            "node": "Anomalies ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anomalies ?": {
      "main": [
        [
          {
            "node": "Formater le message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Formater le message": {
      "main": [
        [
          {
            "node": "Alerte Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lib-error-handler"
  },
  "active": false,
  "tags": [
    {
      "name": "monitor"
    },
    {
      "name": "mvp"
    },
    {
      "name": "wf-3"
    }
  ]
}
