{
  "name": "test-shopify-connection",
  "meta": {
    "description": "Test de connexion Shopify <-> n8n (LECTURE SEULE, méthode 2026 Dev Dashboard). Déclenchement manuel : (1) obtient un token via client_credentials (Client ID/secret depuis les variables n8n), (2) GET /products.json?limit=5 avec header X-Shopify-Access-Token. Confirme que l'app Dev Dashboard est installée + scopes OK. Aucune écriture."
  },
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Lancer le test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.SHOPIFY_STORE_DOMAIN }}/admin/oauth/access_token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "grant_type", "value": "client_credentials" },
            { "name": "client_id", "value": "={{ $env.SHOPIFY_CLIENT_ID }}" },
            { "name": "client_secret", "value": "={{ $env.SHOPIFY_CLIENT_SECRET }}" }
          ]
        },
        "options": {}
      },
      "id": "token",
      "name": "Obtenir token Shopify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://{{ $env.SHOPIFY_STORE_DOMAIN }}/admin/api/{{ $env.SHOPIFY_API_VERSION }}/products.json?limit=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Shopify-Access-Token", "value": "={{ $('Obtenir token Shopify').item.json.access_token }}" }
          ]
        },
        "options": {}
      },
      "id": "products",
      "name": "GET /products.json (read-only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "produits_lus", "value": "={{ ($json.products || []).length }}", "type": "number" },
            { "id": "s2", "name": "premier_produit", "value": "={{ ($json.products && $json.products[0] ? $json.products[0].title : '—') }}", "type": "string" },
            { "id": "s3", "name": "scopes_token", "value": "={{ $('Obtenir token Shopify').item.json.scope }}", "type": "string" },
            { "id": "s4", "name": "token_expire_dans_s", "value": "={{ $('Obtenir token Shopify').item.json.expires_in }}", "type": "number" },
            { "id": "s5", "name": "connexion", "value": "OK ✅", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "ok",
      "name": "Connexion vérifiée",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Lancer le test": { "main": [[{ "node": "Obtenir token Shopify", "type": "main", "index": 0 }]] },
    "Obtenir token Shopify": { "main": [[{ "node": "GET /products.json (read-only)", "type": "main", "index": 0 }]] },
    "GET /products.json (read-only)": { "main": [[{ "node": "Connexion vérifiée", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": [{ "name": "shopify" }, { "name": "test" }]
}
