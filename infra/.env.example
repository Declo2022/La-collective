# =============================================================================
# African College — variables d'environnement (MODÈLE)
# -----------------------------------------------------------------------------
# Ce fichier est un GABARIT. Il ne contient AUCUN secret réel.
# Copiez-le en `.env` (ignoré par git) et remplissez les valeurs, OU
# renseignez ces clés dans le coffre n8n Cloud / GitHub Secrets.
# Chaque clé est documentée dans docs/access-registry.md.
# =============================================================================

# --- Général ---------------------------------------------------------------
APP_ENV=dev                     # dev | prod
LOG_LEVEL=info                  # debug | info | warn | error

# --- Shopify (vitrine, source de vérité commerciale) -----------------------
# Admin API : créer une "custom app" dans la boutique, scopes MINIMAUX.
SHOPIFY_STORE_DOMAIN=           # ex. african-college.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN= # token de l'app privée (shpat_...)
SHOPIFY_API_VERSION=2025-07     # version d'API ÉPINGLÉE (à réviser volontairement)
SHOPIFY_WEBHOOK_SECRET=         # secret HMAC pour vérifier les webhooks

# --- OpenAI (raisonnement des agents) --------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=                  # optionnel
OPENAI_DEFAULT_MODEL=gpt-4.1    # modèle par défaut des agents
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536 # tronqué à 1536 : indexable par pgvector (<= 2000 dims)
OPENAI_SUMMARY_MODEL=gpt-4.1-mini # modèle éco pour les résumés (rapports, digests)
OPENAI_DAILY_TOKEN_CAP=500000   # garde-fou coût : plafond global de tokens/jour (démarrage serré)

# --- Supabase (données & mémoire) ------------------------------------------
SUPABASE_URL=                   # https://<ref>.supabase.co
SUPABASE_ANON_KEY=              # clé publique (front / lecture restreinte)
SUPABASE_SERVICE_ROLE_KEY=      # clé serveur — NE JAMAIS exposer côté client
SUPABASE_DB_URL=                # postgresql://... (migrations CLI)
SUPABASE_PROJECT_REF=           # identifiant projet (dev ET prod = 2 valeurs)

# --- Telegram (poste de commande humain / HITL) ----------------------------
TELEGRAM_BOT_TOKEN=             # token du bot (@BotFather)
TELEGRAM_APPROVALS_CHAT_ID=     # chat/groupe qui reçoit les approbations

# --- Google (GA4 + Search Console via un compte de service partagé) --------
# Un seul service account Google, autorisé sur GA4 ET Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=    # contenu JSON (ou chemin) de la clé de service
GA4_PROPERTY_ID=               # ex. 123456789
GSC_SITE_URL=                  # ex. https://african-college.com/ (propriété GSC)

# --- Microsoft Clarity (signaux UX) ----------------------------------------
CLARITY_PROJECT_ID=            # id du projet Clarity (aussi injecté dans le thème)
CLARITY_API_TOKEN=             # token Data Export API

# --- E-mail (notifications tâches, via Resend) -----------------------------
RESEND_API_KEY=                # clé API Resend
EMAIL_FROM=                    # expéditeur vérifié, ex. college@african-college.com

# --- Slack (alertes de gouvernance — optionnel, prévu pour plus tard) ------
SLACK_WEBHOOK_URL=             # webhook entrant Slack (laisser vide si non utilisé)

# --- n8n Cloud (orchestration) ---------------------------------------------
N8N_BASE_URL=                  # https://<workspace>.app.n8n.cloud
N8N_API_KEY=                   # clé API n8n (export/import des workflows)
N8N_WEBHOOK_BASE=              # base des URLs de webhook entrants

# --- GitHub (renseigné côté GitHub Secrets, pas en local en général) --------
# GITHUB_TOKEN est fourni automatiquement par GitHub Actions.
