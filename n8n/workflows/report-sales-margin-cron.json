{
  "name": "report-sales-margin-cron",
  "meta": {
    "description": "Workflow #2 — Analyse ventes & marges. Chaque semaine : fn_sales_margin_report (agrégats SQL, marge RÉELLE via COGS) -> résumé IA (modèle mini sur chiffres calculés) -> Telegram. Les coûts (unit_cost) sont chargés par CSV (fn_import_variant_costs) ou depuis Shopify InventoryItem.unitCost. Lecture seule, aucune écriture Shopify."
  },
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 7 }] } },
      "id": "cron",
      "name": "Chaque lundi 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_sales_margin_report((current_date - 7), (current_date - 1)) as report;",
        "options": {}
      },
      "id": "report",
      "name": "Ventes & marges (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 0],
      "credentials": { "postgres": { "id": "SUPABASE_PG", "name": "Supabase Postgres" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: ($env.OPENAI_SUMMARY_MODEL || 'gpt-4.1-mini'), max_tokens: 260, messages: [ { role: 'system', content: \"Analyste d'African College. En 4-5 lignes en français : performance de la semaine (CA, marge %, couverture coût), 1 produit à pousser (forte marge), 1 point de vigilance (faible marge). Chiffres fournis uniquement, n'invente rien.\" }, { role: 'user', content: JSON.stringify($json.report) } ] }) }}",
        "options": {}
      },
      "id": "summary",
      "name": "Analyse IA (mini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": { "httpHeaderAuth": { "id": "OPENAI", "name": "OpenAI (Bearer)" } }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=select fn_log_event('llm_call','sales_margin_summary','workflow',null,'report-sales-margin-cron',null,null,null,'info', {{ $json.usage.total_tokens }}, {{ ($json.usage.total_tokens/1000000.0*0.6).toFixed(6) }}, null, null, '{}'::jsonb) as event_id;",
        "options": {}
      },
      "id": "logcost",
      "name": "Journaliser le coût IA",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 0],
      "credentials": { "postgres": { "id": "SUPABASE_PG", "name": "Supabase Postgres" } }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_APPROVALS_CHAT_ID }}",
        "text": "=📈 *Ventes & marges — 7 jours*\\n\\n{{ $('Analyse IA (mini)').item.json.choices[0].message.content }}\\n\\nCA: {{ $('Ventes & marges (SQL)').item.json.report.revenue }} € · Marge: {{ $('Ventes & marges (SQL)').item.json.report.gross_margin }} € ({{ $('Ventes & marges (SQL)').item.json.report.gross_margin_pct }}%) · Couv. coût: {{ $('Ventes & marges (SQL)').item.json.report.cost_coverage_pct }}%",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram",
      "name": "Envoyer (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 0],
      "credentials": { "telegramApi": { "id": "TELEGRAM_BOT", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Chaque lundi 07:00": { "main": [[{ "node": "Ventes & marges (SQL)", "type": "main", "index": 0 }]] },
    "Ventes & marges (SQL)": { "main": [[{ "node": "Analyse IA (mini)", "type": "main", "index": 0 }]] },
    "Analyse IA (mini)": { "main": [[{ "node": "Journaliser le coût IA", "type": "main", "index": 0 }]] },
    "Journaliser le coût IA": { "main": [[{ "node": "Envoyer (Telegram)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "lib-error-handler" },
  "active": false,
  "tags": [{ "name": "report" }, { "name": "mvp" }, { "name": "wf-2" }]
}
