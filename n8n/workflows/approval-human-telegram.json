{
  "name": "approval-human-telegram",
  "meta": {
    "description": "Workflow #9 — Réception de la décision humaine. Déclenché par un clic sur un bouton Telegram (callback_query). Parse 'approve:<id>' / 'reject:<id>', enregistre la décision humaine (fn_record_decision) et confirme dans le fil."
  },
  "nodes": [
    {
      "parameters": { "updates": ["callback_query"], "additionalFields": {} },
      "id": "tg-trigger",
      "name": "Clic bouton Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_BOT", "name": "Telegram Bot" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "decision",
              "value": "={{ $json.callback_query.data.split(':')[0] === 'approve' ? 'approved' : 'rejected' }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "request_id",
              "value": "={{ $json.callback_query.data.split(':')[1] }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "tg_user",
              "value": "={{ $json.callback_query.from.username || $json.callback_query.from.id }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "parse",
      "name": "Parser la décision",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select fn_record_decision($1::uuid, 'human', (select id from people where role='founder_final_approver' limit 1), 'human', $2, $3) as resultat;",
        "options": { "queryReplacement": "={{ $json.request_id }},={{ $json.decision }},={{ 'via Telegram: ' + $json.tg_user }}" }
      },
      "id": "record",
      "name": "Enregistrer la décision",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 0],
      "credentials": {
        "postgres": { "id": "SUPABASE_PG", "name": "Supabase Postgres" }
      }
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Clic bouton Telegram').item.json.callback_query.message.chat.id }}",
        "text": "=Décision enregistrée : {{ $('Parser la décision').item.json.decision }} ✅",
        "additionalFields": {}
      },
      "id": "confirm",
      "name": "Confirmer dans le fil",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 0],
      "credentials": {
        "telegramApi": { "id": "TELEGRAM_BOT", "name": "Telegram Bot" }
      }
    }
  ],
  "connections": {
    "Clic bouton Telegram": { "main": [[{ "node": "Parser la décision", "type": "main", "index": 0 }]] },
    "Parser la décision": { "main": [[{ "node": "Enregistrer la décision", "type": "main", "index": 0 }]] },
    "Enregistrer la décision": { "main": [[{ "node": "Confirmer dans le fil", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "tags": [{ "name": "approval" }, { "name": "mvp" }, { "name": "wf-9" }]
}
